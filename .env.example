# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional OpenAI API key to power ChatGPT encouragement & life consultation
OPENAI_API_KEY="MY_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4o-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase Project URL (Settings > API)
SUPABASE_URL="MY_SUPABASE_URL"

# SUPABASE_SERVICE_ROLE_KEY: Recommended for private single-owner DB access (bypasses RLS strictly on server)
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# SUPABASE_ANON_KEY: Optional fallback anon key if service role key is not set
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# OWNER_PASSCODE: Personal passcode so only you can unlock Backoffice & view/sync your private database
OWNER_PASSCODE="MY_OWNER_PASSCODE"
